# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT: generate two independent random values of at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed browser origins (for example, Vite's Vue dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
